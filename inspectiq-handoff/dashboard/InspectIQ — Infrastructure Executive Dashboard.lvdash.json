{
  "datasets": [
    {
      "name": "ds_assets_enriched",
      "displayName": "Assets (enriched)",
      "queryLines": [
        "SELECT\n",
        "\n",
        "  report_id, project_name, inspection_type, state,\n",
        "\n",
        "  CASE state\n",
        "\n",
        "    WHEN 'PA' THEN 'Mid-Atlantic'  WHEN 'NJ' THEN 'Mid-Atlantic'\n",
        "\n",
        "    WHEN 'DE' THEN 'Mid-Atlantic'  WHEN 'MD' THEN 'Mid-Atlantic'\n",
        "\n",
        "    WHEN 'NY' THEN 'Northeast'     WHEN 'MA' THEN 'Northeast'\n",
        "\n",
        "    WHEN 'CT' THEN 'Northeast'     WHEN 'VA' THEN 'Southeast'\n",
        "\n",
        "    WHEN 'NC' THEN 'Southeast'     WHEN 'GA' THEN 'Southeast'\n",
        "\n",
        "    WHEN 'FL' THEN 'Southeast'     WHEN 'OH' THEN 'Midwest'\n",
        "\n",
        "    WHEN 'IL' THEN 'Midwest'       WHEN 'MI' THEN 'Midwest'\n",
        "\n",
        "    WHEN 'TX' THEN 'Southwest'     WHEN 'CO' THEN 'Southwest'\n",
        "\n",
        "    WHEN 'CA' THEN 'Pacific'       WHEN 'WA' THEN 'Pacific'\n",
        "\n",
        "    ELSE 'Other'\n",
        "\n",
        "  END AS region,\n",
        "\n",
        "  client, condition_category, condition_rating, priority,\n",
        "\n",
        "  overdue, safety_flagged, nbis_deficient,\n",
        "\n",
        "  estimated_repair_cost, days_overdue, inspection_date,\n",
        "\n",
        "  DATE_TRUNC('MONTH', inspection_date) AS inspection_month,\n",
        "\n",
        "  CASE\n",
        "\n",
        "    WHEN overdue = false OR days_overdue IS NULL OR days_overdue <= 0 THEN 'On schedule'\n",
        "\n",
        "    WHEN days_overdue <= 30 THEN '1-30 days'\n",
        "\n",
        "    WHEN days_overdue <= 90 THEN '31-90 days'\n",
        "\n",
        "    WHEN days_overdue <= 180 THEN '91-180 days'\n",
        "\n",
        "    ELSE '180+ days'\n",
        "\n",
        "  END AS days_overdue_bucket,\n",
        "\n",
        "  CASE WHEN overdue = true AND safety_flagged = true THEN 1 ELSE 0 END AS overdue_and_safety_flag,\n",
        "\n",
        "  CASE WHEN condition_category IN ('Critical','Poor') THEN 1 ELSE 0 END AS needs_action_flag,\n",
        "  CASE WHEN overdue = true THEN days_overdue END AS days_overdue_when_overdue,\n",
        "\n",
        "  CASE WHEN safety_flagged = true THEN 1 ELSE 0 END AS safety_flag_int,\n",
        "\n",
        "  CASE WHEN nbis_deficient = true THEN 1 ELSE 0 END AS nbis_flag_int,\n",
        "\n",
        "  CASE WHEN overdue = true THEN 1 ELSE 0 END AS overdue_flag_int\n",
        "\n",
        "FROM mbi_demo.inspectiq.project_assets"
      ]
    },
    {
      "name": "ds_metrics_portfolio",
      "displayName": "Metric View: Asset Portfolio (Semantic Layer)",
      "queryLines": [
        "SELECT\n",
        "  inspection_type,\n",
        "  condition_category,\n",
        "  state,\n",
        "  client,\n",
        "  MEASURE(asset_count)          AS asset_count,\n",
        "  MEASURE(overdue_pct)          AS overdue_pct,\n",
        "  MEASURE(safety_flagged_pct)   AS safety_flagged_pct,\n",
        "  MEASURE(avg_condition_rating) AS avg_condition_rating,\n",
        "  MEASURE(total_repair_cost)    AS total_repair_cost,\n",
        "  MEASURE(nbis_deficient_count) AS nbis_deficient_count,\n",
        "  MEASURE(avg_priority_score)   AS avg_priority_score\n",
        "FROM mbi_demo.inspectiq.metrics_asset_portfolio\n",
        "GROUP BY inspection_type, condition_category, state, client"
      ]
    },
    {
      "name": "ds_metrics_overdue",
      "displayName": "Metric View: Overdue Risk (Semantic Layer)",
      "queryLines": [
        "SELECT\n",
        "  state,\n",
        "  inspection_type,\n",
        "  priority,\n",
        "  MEASURE(overdue_asset_count)        AS overdue_asset_count,\n",
        "  MEASURE(avg_days_overdue)           AS avg_days_overdue,\n",
        "  MEASURE(max_days_overdue)           AS max_days_overdue,\n",
        "  MEASURE(total_overdue_cost)         AS total_overdue_cost,\n",
        "  MEASURE(safety_flagged_overdue_count) AS safety_overdue_count,\n",
        "  MEASURE(critical_overdue_count)     AS critical_overdue_count\n",
        "FROM mbi_demo.inspectiq.metrics_overdue_risk\n",
        "GROUP BY state, inspection_type, priority"
      ]
    }
  ],
